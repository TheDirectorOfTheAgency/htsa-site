---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  robots?: string;
}

const {
  title = "The Agency | Operator coaching for home service owners",
  description = "The Agency — operator coaching for home service owners. $1,997 a month, month to month, application only. The community foyer on Skool is $1 a month.",
  robots,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="dns-prefetch" href="https://api.x.ai" />
    <link rel="preconnect" href="https://api.x.ai" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
