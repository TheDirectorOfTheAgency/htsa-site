---
import CallButton from "./CallButton.astro";
---

<div class="sticky-call">
  <CallButton />
</div>

<style>
  .sticky-call {
    display: none;
  }

  @media (max-width: 767px) {
    .sticky-call {
      display: flex;
      position: fixed;
      bottom: max(16px, env(safe-area-inset-bottom));
      left: 16px;
      right: 16px;
      z-index: 40;
      justify-content: center;
    }

    .sticky-call .btn-call {
      width: 100%;
      justify-content: center;
      padding: 14px 24px;
      background: var(--yellow);
      color: var(--yellow-ink);
      border: none;
      font-weight: 650;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    }

    .sticky-call .btn-call:disabled {
      background: var(--grey-card);
      color: var(--muted);
    }
  }
</style>
