<footer class="footer">
  <div class="container footer__inner">
    <p class="footer__brand">The Mounting Man</p>
    <p class="footer__note">Hollywood Handyman is the teacher — not a second company.</p>
    <p class="footer__copy">&copy; {new Date().getFullYear()} The Mounting Man. All rights reserved.</p>
  </div>
</footer>

<style>
  .footer {
    padding: var(--space-7) 0;
    border-top: 1px solid var(--line-dark);
    background: var(--white);
  }

  .footer__inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer__brand {
    font-weight: 650;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: var(--font-small);
  }

  .footer__note {
    color: var(--muted);
    font-size: var(--font-small);
  }

  .footer__copy {
    color: var(--muted);
    font-size: 0.75rem;
  }
</style>
