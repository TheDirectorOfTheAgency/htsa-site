---
import { BOOKING_CTA, BOOKING_URL } from "../config";
---

<section class="hero">
  <div class="hero__inner container">
    <p class="eyebrow">High Ticket Service Academy</p>
    <h1 class="hero__title">AI can take the corner office. It can't mount the TV.</h1>
    <p class="hero__sub">
      The trades are the last moat. High Ticket Service Academy teaches blue-collar operators to run their work like a business, with ads, SEO, and AI, and to charge what it's worth.
    </p>
    <div class="hero__cta">
      <a class="btn-primary" href={BOOKING_URL}>{BOOKING_CTA}</a>
      <a class="hero__secondary" href="#meet-moneypenny">Or talk to MoneyPenny</a>
    </div>
  </div>
</section>

<style>
  .hero {
    background: var(--black);
    color: var(--white);
    padding-top: var(--space-9);
    padding-bottom: var(--space-9);
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
  }

  .hero .eyebrow {
    color: var(--yellow);
  }

  .hero__title {
    font-size: var(--font-hero);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.035em;
    max-width: 14ch;
  }

  .hero__sub {
    max-width: 38rem;
    font-size: 1.2rem;
    color: var(--muted-on-dark);
    line-height: 1.5;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
    margin-top: var(--space-3);
  }

  .hero__secondary {
    color: var(--white);
    text-decoration: underline;
    text-underline-offset: 4px;
    font-size: var(--font-body);
  }

  .hero__secondary:hover {
    color: var(--yellow);
  }

  @media (max-width: 767px) {
    .hero {
      padding-top: var(--space-8);
    }
  }
</style>
