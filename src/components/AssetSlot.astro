---
interface Props {
  variant: "image" | "video";
}

const { variant } = Astro.props;
const label =
  variant === "image"
    ? "Hero image slot — Mr. Wayne supplies this asset"
    : "Hero video slot — Mr. Wayne supplies this asset";
---

<div class={`asset-slot asset-slot--${variant}`}>
  {variant === "video" && (
    <div class="asset-slot__play" aria-hidden="true">
      <svg width="48" height="48" viewBox="0 0 48 48" fill="none">
        <circle cx="24" cy="24" r="23" stroke="rgba(255,255,255,0.4)" stroke-width="2"/>
        <path d="M20 16l14 8-14 8V16z" fill="rgba(255,255,255,0.7)"/>
      </svg>
    </div>
  )}
  <span class="asset-slot__label">{label}</span>
</div>

<style>
  .asset-slot {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--hero-slot);
    border: 1px solid var(--line);
    color: var(--muted-on-dark);
    font-size: var(--font-small);
    text-align: center;
    padding: var(--space-6);
  }

  .asset-slot--image {
    position: absolute;
    inset: 0;
    z-index: 0;
    border: none;
    border-radius: 0;
  }

  .asset-slot--video {
    width: 100%;
    max-width: 1040px;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-frame);
    margin-inline: auto;
  }

  .asset-slot__play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.6;
  }

  .asset-slot__label {
    position: relative;
    z-index: 1;
    max-width: 28ch;
  }
</style>
