---
interface Props {
  variant: "image" | "video";
}

import { HERO_VIMEO_ID } from "../config";

const { variant } = Astro.props;
const vimeo = variant === "video" && HERO_VIMEO_ID ? HERO_VIMEO_ID : "";
const label =
  variant === "image"
    ? ""
    : "Hero video slot — Mr. Wayne supplies this asset";
---

{vimeo ? (
  <div class="hero-video">
    <iframe
      src={`https://player.vimeo.com/video/${vimeo}?title=0&byline=0&portrait=0&dnt=1`}
      title="The Agency — watch Mr. Wayne explain the system"
      loading="lazy"
      allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media"
      referrerpolicy="strict-origin-when-cross-origin"
      allowfullscreen
    ></iframe>
  </div>
) : (
<div class={`asset-slot asset-slot--${variant}`}>
  {variant === "video" && (
    <div class="asset-slot__play" aria-hidden="true">
      <svg width="48" height="48" viewBox="0 0 48 48" fill="none">
        <circle cx="24" cy="24" r="23" stroke="rgba(255,255,255,0.4)" stroke-width="2"/>
        <path d="M20 16l14 8-14 8V16z" fill="rgba(255,255,255,0.7)"/>
      </svg>
    </div>
  )}
  {label && <span class="asset-slot__label">{label}</span>}
</div>
)}

<style>
  .asset-slot--image .asset-slot__label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .hero-video {
    width: 100%;
    max-width: 820px;
    aspect-ratio: 16 / 9;
    margin-inline: auto;
    border-radius: var(--radius-frame);
    overflow: hidden;
    border: 1px solid var(--line);
    background: #000;
  }
  .hero-video iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .asset-slot {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--hero-slot);
    border: 1px solid var(--line);
    color: var(--muted-on-dark);
    font-size: var(--font-small);
    text-align: center;
    padding: var(--space-6);
  }

  .asset-slot--image {
    position: absolute;
    inset: 0;
    z-index: 0;
    border: none;
    border-radius: 0;
  }

  .asset-slot--video {
    width: 100%;
    max-width: 820px;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-frame);
    margin-inline: auto;
  }

  .asset-slot__play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.6;
  }

  .asset-slot__label {
    position: relative;
    z-index: 1;
    max-width: 28ch;
  }
</style>
